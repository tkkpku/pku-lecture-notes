# 环境变量清单（示例）
# ============================================================================
# ⚠️ 注意：本项目**不加载任何 .env 文件**（没有引入 dotenv）。
#    本文件只是一张"有哪些变量、默认值是什么"的清单。
#    请直接在 shell 里设置：
#      PowerShell:  $env:LLM_API_KEY='sk-...' ; $env:GARMIN_CDP_PORT='9222'
#      bash/zsh:    export LLM_API_KEY=sk-...   export GARMIN_CDP_PORT=9222
#    （把密钥写进文件再忘了 gitignore，是这类项目最常见的事故）
# ============================================================================

# LLM（OpenAI 兼容端点）。变量名必须与 config.yaml 的 llm.key_env 一致
LLM_API_KEY=

# 例：
#   DeepSeek 官方   base_url=https://api.deepseek.com/v1        model=deepseek-chat
#   阿里百炼(兼容)  base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 vLLM       base_url=http://127.0.0.1:8000/v1            LLM_API_KEY=not-needed
#   ⚠️ 读图（OCR 阶段）需要多模态模型；纯文本模型只能跑 fuse

# 国内 HF 镜像（默认已设 hf-mirror；海外可设官方站）
# HF_ENDPOINT=https://hf-mirror.com

# 首次下载 ASR 模型时自动放开（一般不用手设，代码会自己判断模型是否已存在）
# LECTURE_HF_ALLOW_DOWNLOAD=1
